# Becker solution verification - compressible Navier-Stokes
# Reference: Guermond et al., Section 6.1
# This produces a convergence study for the 1D viscous shock (Becker solution)

subsection A - TimeLoop
    set basename          = becker-verification
    set final time        = 2.0
    set timer granularity = 2.0    # Only output at final time
end

subsection B - Equation
    set dimension       = 2
    set equation        = navier_stokes
    set gamma           = 1.4
    set mu              = 0.01
    set lambda          = 0.0
    set kappa           = 1.866666666666666e-02
end

subsection C - Discretization
    set geometry        = rectangle
    set mesh refinement = 0

    # Paper Section 6.1: domain is the UNIT SQUARE [0,1]^2 with Dirichlet on left/right
    # and periodic on top/bottom (we use slip top/bottom — equivalent for the
    # y-invariant Becker solution).
    subsection rectangle
        set x left         = 0.0
        set x right        = 1.0
        set y bottom       = 0.0
        set y top          = 1.0
        set subdivisions x = 64
        set subdivisions y = 64
    end
end

subsection E - InitialValues
    set configuration = becker solution
    set direction     = 1, 0
    # Initial shock-center offset: place shock at x=0.25 at t=0 (left quarter of
    # the unit square). With galilean=0.125 and t_final=2.0, the shock travels
    # from x=0.25 to x=0.5 (center of the domain).
    set position      = 0.25

    subsection uniform
        # Not used for Becker, but must be present
        set primitive state = 1.0, 1.2, 0.0794
    end

    subsection becker solution
        # Match ryujin's becker_solution-erk33.prm
        set velocity galilean frame = 0.125
        set velocity left           = 1.0
        set velocity right          = 0.259259259259
        set density left            = 1.0
    end
end

subsection H - TimeIntegrator
    # Paper Section 6.1: "we slightly deviate from [31] by choosing... CFL number 0.3"
    set cfl min = 0.30
    set cfl max = 0.30
end
