# Navier-Stokes NACA flow
subsection A - TimeLoop
    set basename            = ns-naca-2d
    set enable output full  = true
    set final time          = 5.0
    set timer granularity   = 0.1
end
subsection B - Equation
    set dimension       = 2
    set equation        = navier_stokes
    set gamma           = 1.401
    set prandtl number  = 0.75
    set mach number     = 0.73
    set mu reference    = 1.0e-3
    set reynolds number = 3.0e6
end
subsection C - Discretization
    set geometry        = airfoil
    set mesh refinement = 4
    
    subsection airfoil
        set naca id              = 2412
        set airfoil length       = 1
        set height               = 2
        set length b2            = 3
        set incline factor       = 0.0
        set n subdivisions x 0   = 2
        set n subdivisions x 1   = 3
        set n subdivisions x 2   = 4
        set n subdivisions y     = 2
    end
end
subsection E - InitialValues
    set configuration = uniform
    set direction     = 0.99254615, 0.12186934, 0
    set position      = 1, 0, 0
    set perturbation  = 0
    
    subsection uniform
        set primitive state = 1.4, 0.73, 1
    end
end
subsection H - TimeIntegrator
    set cfl min               = 0.90
    set cfl max               = 0.90
    set cfl recovery strategy = none
    set time stepping scheme  = strang erk 33 cn
end
subsection J - VTUOutput
    set use mpi io     = true
    set schlieren beta = 10
end
